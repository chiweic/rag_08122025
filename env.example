# DDM RAG System Configuration

# LLM Configuration
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus-2025-09-11
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=3000

# Google API Key (required for Gemini)
GOOGLE_API_KEY=your_gemini_api_key

# OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# DashScope API Key (required for DashScope embeddings)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL = "text-embedding-v4"

# Custom LLM (not currently used)
# CUSTOM_LLM_BASE_URL=http://area51r5:8000/v1
# CUSTOM_LLM_API_KEY=empty

# STAPI Configuration (self-hosted embedding API)
# Note: OLLAMA_* variables are kept for backward compatibility
OLLAMA_BASE_URL=http://ollama.changpt.org/v1
OLLAMA_API_KEY=dummy_key
OLLAMA_MAX_WORKERS=1  # Sequential processing to avoid API timeouts

# Embedding Configuration
# Options: google (Gemini), openai, huggingface, local, dashscope, ollama (STAPI)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ddm_rag

# RAG Configuration
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=5

DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_journey
DB_USER=ddm_user
DB_PASSWORD=change_this_password  # Use the password from docker-compose.yml

# JWT Secret (paste the generated key from step 2)
SECRET_KEY=paste_your_generated_key_here

# Email (Migadu example)
SMTP_SERVER=smtp.migadu.com
SMTP_USERNAME=info@changpt.org
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=info@changpt.org
SMTP_PORT=465